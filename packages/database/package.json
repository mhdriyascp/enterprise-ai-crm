{
  "name": "@crm/database",
  "version": "0.1.0",
  "description": "Shared database client and utilities for the Enterprise AI CRM platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@crm/logging": "workspace:*",
    "@prisma/client": "^5.16.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.16.1",
    "typescript": "^5.5.2"
  }
}
