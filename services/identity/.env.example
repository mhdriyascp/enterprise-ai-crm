# Service Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=@crm/identity
SERVICE_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm_identity

# Redis
REDIS_URL=redis://:crm_redis_password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=crm-identity
KAFKA_GROUP_ID=crm-identity-group

# JWT
JWT_SECRET=change_this_in_production_minimum_32_chars
JWT_ISSUER=http://localhost:8080/realms/crm
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800

# Password hashing
BCRYPT_ROUNDS=12

# CORS ("*" allows all, or a comma-separated list of origins)
CORS_ORIGINS=*

# Rate limiting (authentication endpoints)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
