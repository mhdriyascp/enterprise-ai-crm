# Service Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=@crm/lead
SERVICE_VERSION=0.1.0

# Database
DATABASE_URL=******localhost:5432/crm_lead

# Redis
REDIS_URL=redis://:crm_redis_password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=crm-lead
KAFKA_GROUP_ID=crm-lead-group

# JWT
JWT_SECRET=change_this_in_production_minimum_32_chars
JWT_ISSUER=http://localhost:8080/realms/crm

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
