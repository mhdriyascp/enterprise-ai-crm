# Service Configuration
NODE_ENV=development
PORT=3103
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=@crm/opportunity
SERVICE_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm_opportunity

# Redis
REDIS_URL=redis://:crm_redis_password@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=crm-opportunity
KAFKA_GROUP_ID=crm-opportunity-group

# JWT (must match the Identity service that issues tokens)
JWT_SECRET=change_this_in_production_minimum_32_chars
JWT_ISSUER=http://localhost:8080/realms/crm

# CORS ("*" allows all, or a comma-separated list of origins)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
