// =============================================================================
// Customer Service — Prisma Schema
// Owns the `crm_customer` database. Multi-tenant: every row is scoped by
// tenantId (the isolation boundary enforced by the Identity service / gateway).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Customer — a company / account managed within a tenant.
// -----------------------------------------------------------------------------
model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  name         String
  email        String?
  phone        String?
  website      String?
  industry     String?
  size         CompanySize?
  revenue      Decimal?       @db.Decimal(18, 2)
  currency     String?        @db.Char(3)
  status       CustomerStatus @default(prospect)
  ownerId      String?        @map("owner_id") @db.Uuid
  tags         String[]       @default([])
  customFields Json           @default("{}") @map("custom_fields")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, ownerId])
  @@map("customers")
}

enum CompanySize {
  solo
  small
  medium
  large
  enterprise
}

enum CustomerStatus {
  active
  inactive
  prospect
  churned
}
