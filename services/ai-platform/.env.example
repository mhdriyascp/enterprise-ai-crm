# Service Configuration
NODE_ENV=development
PORT=3200
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=@crm/ai-platform
SERVICE_VERSION=0.1.0

# Database
DATABASE_URL=******localhost:5432/crm_ai_platform

# Redis
REDIS_URL=redis://:crm_redis_password@localhost:6379

# Kafka / Event bus
EVENTS_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=crm-ai-platform

# JWT (must match the Identity service that issues tokens)
JWT_SECRET=change_this_in_production_minimum_32_chars
JWT_ISSUER=http://localhost:8080/realms/crm

# CORS ("*" allows all, or a comma-separated list of origins)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# LLM provider — "mock" (deterministic, offline) or "openai" (OpenAI-compatible)
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Embeddings provider — "mock" (deterministic, offline) or "openai"
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Vector store — "memory" (in-process, offline) or "qdrant"
# ---------------------------------------------------------------------------
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# RAG chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
