# Service Configuration
NODE_ENV=development
PORT=3300
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=@crm/mobile-api
SERVICE_VERSION=0.1.0

# Upstream API gateway (Kong) used for aggregation
UPSTREAM_GATEWAY_URL=http://localhost:8000
UPSTREAM_TIMEOUT_MS=5000

# Mobile response tuning
MOBILE_PAGE_SIZE=20

# JWT (must match the Identity service that issues tokens)
JWT_SECRET=change_this_in_production_minimum_32_chars
JWT_ISSUER=http://localhost:8080/realms/crm

# CORS ("*" allows all, or a comma-separated list of origins)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
